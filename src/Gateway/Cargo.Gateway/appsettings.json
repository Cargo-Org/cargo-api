{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Authority": "https://cargo.northeurope.cloudapp.azure.com/keycloak/realms/cargo",
    "MetadataAddress": "http://keycloak:8080/keycloak/realms/cargo/.well-known/openid-configuration",
    "Audience": "cargo-backend"
  },
  "ReverseProxy": {
    "Routes": {
      "scalar-customer-openapi": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "anonymous",
        "Order": 1,
        "Match": {
          "Path": "/docs/customer/openapi/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/{**catch-all}"
          }
        ]
      },
      "scalar-customer-ui": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "anonymous",
        "Order": 2,
        "Match": {
          "Path": "/docs/customer/{*catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/scalar/{**catch-all}"
          }
        ]
      },
      "customer-service": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "default",
        "Order": 10,
        "Match": {
          "Path": "/api/customer/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/{**catch-all}"
          }
        ]
      },
      "scalar-driver-openapi": {
        "ClusterId": "driver-cluster",
        "AuthorizationPolicy": "anonymous",
        "Order": 1,
        "Match": {
          "Path": "/docs/driver/openapi/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/{**catch-all}"
          }
        ]
      },
      "scalar-driver-ui": {
        "ClusterId": "driver-cluster",
        "AuthorizationPolicy": "anonymous",
        "Order": 2,
        "Match": {
          "Path": "/docs/driver/{*catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/scalar/{**catch-all}"
          }
        ]
      },
      "driver-service": {
        "ClusterId": "driver-cluster",
        "AuthorizationPolicy": "default",
        "Order": 10,
        "Match": {
          "Path": "/api/driver/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "customer-cluster": {
        "Destinations": {
          "customer-service": {
            "Address": "http://customer-service:8080"
          }
        }
      },
      "driver-cluster": {
        "Destinations": {
          "driver-service": {
            "Address": "http://driver-service:8080"
          }
        }
      }
    }
  }
}