{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/cargo",
    "MetadataAddress": "http://keycloak:8080/keycloak/realms/cargo/.well-known/openid-configuration",
    "Audience": "cargo-api"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-token-route": {
        "ClusterId": "keycloak-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/token"
        },
        "Transforms": [
          { "PathSet": "/realms/cargo/protocol/openid-connect/token" }
        ]
      },
      "customer-register-route": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/customers/register",
          "Methods": [ "POST" ]
        },
        "Transforms": [ { "PathRemovePrefix": "/api/customers" } ]
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/customers/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/customers" } ]
      },
      "customer-openapi-route": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/openapi/customers" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      }
    },
    "Clusters": {
      "keycloak-cluster": {
        "Destinations": {
          "keycloak-destination": {
            "Address": "http://keycloak:8080/keycloak"
          }
        }
      },
      "customer-cluster": {
        "Destinations": {
          "customer-service": {
            "Address": "http://customer-service:8080"
          }
        }
      }
    }
  }
}
