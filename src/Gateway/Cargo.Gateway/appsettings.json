{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Authority": "https://cargo.northeurope.cloudapp.azure.com/keycloak/realms/cargo",
    "MetadataAddress": "http://keycloak:8080/keycloak/realms/cargo/.well-known/openid-configuration",
    "Audience": "cargo-backend"
  },
  "ReverseProxy": {
    "Routes": {
      "customer-service-all": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customer/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/customer"
          }
        ]
      },
      "openapi": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/openapi/customer/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/openapi/customer"
          },
          {
            "PathPrefix": "/openapi"
          }
        ]
      }
    },
    "Clusters": {
      "customer-cluster": {
        "Destinations": {
          "customer-service": {
            "Address": "http://customer-service:8080"
          }
        }
      }
    }
  }
}