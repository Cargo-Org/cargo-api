{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Authority": "https://cargo.northeurope.cloudapp.azure.com/keycloak/realms/cargo",
    "MetadataAddress": "http://keycloak:8080/keycloak/realms/cargo/.well-known/openid-configuration",
    "Audience": "cargo-backend"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-register": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/register",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "auth-login": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/login",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "auth-refresh": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/refresh-token",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "auth-verify-email": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/verify-email",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "auth-google": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/google",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "auth-forgot-password": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/forgot-password",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "auth-reset-password": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/reset-password",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "auth-logout": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/auth/logout",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "profile-get": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/me",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "profile-update": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/me",
          "Methods": [
            "PATCH"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "addresses": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/me/addresses/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "documents": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/me/documents/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "documents-upload-url": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/me/documents/upload-url",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "admin-documents-review": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/admin/documents/{id}/review",
          "Methods": [
            "PATCH"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "openapi": {
        "ClusterId": "customer-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/openapi/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "customer-cluster": {
        "Destinations": {
          "customer-service": {
            "Address": "http://customer-service:8080"
          }
        }
      }
    }
  }
}