<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Cargo.BuildingBlocks</RootNamespace>
		<AssemblyName>Cargo.BuildingBlocks</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AWSSDK.S3" Version="4.0.23" />
		<PackageReference Include="RabbitMQ.Client" Version="7.*" />
		<!-- EF Core abstractions needed by IOutboxDbContext / OutboxPublisherWorker -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.*" />
		<PackageReference Include="MediatR" Version="12.*" />
		<PackageReference Include="ErrorOr" Version="2.*" />
		<PackageReference Include="FluentValidation" Version="11.*" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.7" />
		<PackageReference Include="Scalar.AspNetCore" Version="2.14.11" />
	</ItemGroup>

</Project>