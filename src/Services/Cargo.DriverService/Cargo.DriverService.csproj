<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>..\..\..</DockerfileContext>
	</PropertyGroup>

	<ItemGroup>
		<!-- JWT Bearer authentication middleware -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.*" />

		<!-- OpenAPI document generation -->
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />

		<!-- Scalar UI — renders the OpenAPI document as interactive documentation -->
		<PackageReference Include="Scalar.AspNetCore" Version="2.*" />

		<!-- Entity Framework Core — the ORM -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.*" />

		<!-- EF Core design tools — needed to run dotnet ef migrations add -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*" />

		<!-- PostgreSQL driver for EF Core -->
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />

		<!-- MediatR — mediator pattern, CQRS dispatch -->
		<PackageReference Include="MediatR" Version="12.*" />

		<!-- FluentValidation — strongly typed validation rules -->
		<PackageReference Include="FluentValidation" Version="11.*" />

		<!-- FluentValidation DI extensions — RegisterValidatorsFromAssembly -->
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.*" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\BuildingBlocks\Cargo.BuildingBlocks\Cargo.BuildingBlocks.csproj" />
		<ProjectReference Include="..\..\BuildingBlocks\Cargo.Observability\Cargo.Observability.csproj" />
	</ItemGroup>

</Project>
