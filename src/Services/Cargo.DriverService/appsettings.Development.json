{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/keycloak/realms/cargo-driver",
    "MetadataAddress": "http://localhost:8080/keycloak/realms/cargo-driver/.well-known/openid-configuration",
    "Audience": "cargo-backend"
  },
  "Keycloak_Backend": {
    "BaseUrl": "http://localhost:8080/keycloak",
    "Realm": "cargo-driver",
    "ClientId": "cargo-backend",
    "ClientSecret": "<override-via-user-secrets>"
  },
  "ConnectionStrings": {
    "DriverDb": "Host=localhost;Port=5432;Database=driver_db;Username=cargo_postgres_dev_user;Password=<override-via-user-secrets>"
  },
  "Storage": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin123",
    "BucketName": "cargo-driver-documents",
    "ForcePathStyle": true
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "From": "<override-via-user-secrets>",
    "Password": "<override-via-user-secrets>",
    "DisplayName": "Cargo Dev",
    "UseSsl": false,
    "UseStartTls": true
  },
  "OtpSettings": {
    "TtlMinutes": 5,
    "CodeLength": 5
  },
  "REDIS": {
    "ConnectionString": "localhost:6379,password=<override-via-user-secrets>"
  },
  "Gateway": {
    "BaseUrl": "http://localhost:5001"
  }
}
