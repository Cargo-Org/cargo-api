<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>..\..\..\</DockerfileContext>
	</PropertyGroup>

	<ItemGroup>
		<!-- Email delivery — MailKit is the only service that needs this now -->
		<PackageReference Include="MailKit" Version="4.*" />

		<!-- RabbitMQ consumer -->
		<PackageReference Include="RabbitMQ.Client" Version="7.*" />
	</ItemGroup>

	<ItemGroup>
		<!-- Shared messaging contracts (NotificationMessage, NotificationChannel, etc.) -->
		<ProjectReference Include="..\..\BuildingBlocks\Cargo.BuildingBlocks\Cargo.BuildingBlocks.csproj" />
		<ProjectReference Include="..\..\BuildingBlocks\Cargo.Observability\Cargo.Observability.csproj" />
	</ItemGroup>

</Project>
