cargo.northeurope.cloudapp.azure.com {
    # 1. Keycloak — preserve /keycloak prefix (KC_HTTP_RELATIVE_PATH=/keycloak)
    handle /keycloak* {
        reverse_proxy keycloak:8080
    }

    # 2. API routes — YARP gateway handles routing + JWT validation
    handle /api/* {
        reverse_proxy gateway:8080
    }

    # 3. OpenAPI docs — proxied directly to customer-service
    handle /openapi/* {
        reverse_proxy customer-service:8080
    }

    # 4. Health check — gateway health endpoint
    handle /health {
        reverse_proxy gateway:8080
    }
}
# 'handle' keeps the matched path prefix when forwarding to the upstream