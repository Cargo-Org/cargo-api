# =============================================================================
# CARGO API — Production Environment Variables
# =============================================================================
# Copy this file to `.env` on the Azure VM (never commit .env to git).
# Fill in every value marked <CHANGE_ME>.
# =============================================================================


# --- Keycloak Configuration ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<CHANGE_ME>

KC_HEALTH_ENABLED=true
KC_HOSTNAME=cargo.northeurope.cloudapp.azure.com
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak_db


# --- PostgreSQL Configuration ---
DB_USERNAME=cargo_postgres_prod_user
DB_PASSWORD=<CHANGE_ME>


# --- Gateway Configuration ---
GW_ASPNETCORE_ENVIRONMENT=Production
GW_Keycloak_Address=http://keycloak:8080/keycloak
GW_Customer_Service_Address=http://customer-service:8080/


# --- Customer Service Configuration ---
CS_ASPNETCORE_ENVIRONMENT=Production
CS_Connection_String="Host=postgres;Port=5432;Database=customer_db;Username=cargo_postgres_prod_user;Password=<CHANGE_ME>"

# Authority = public HTTPS URL (must match Keycloak token issuer)
CS_KC_Authority=https://cargo.northeurope.cloudapp.azure.com/keycloak/realms/cargo-customer

# MetadataAddress = internal container URL for key fetching (keeps key fetch inside Docker network)
CS_KC_MetadataAddress=http://keycloak:8080/keycloak/realms/cargo-customer/.well-known/openid-configuration

CS_KC_BaseUrl=http://keycloak:8080/keycloak
CS_KC_Realm=cargo-customer
CS_KC_Audience=cargo-backend
CS_KC_Backend_ClientId=cargo-backend
CS_KC_Backend_ClientSecret=<CHANGE_ME>        # Copy from Keycloak Admin → Clients → cargo-backend → Credentials


# --- Cloudflare R2 Storage ---
CS_CF_Storage_AccessKey=<CHANGE_ME>
CS_CF_Storage_BucketName=cargo-customer-documents
CS_CF_Storage_Endpoint=<CHANGE_ME>           # e.g. https://<account>.r2.cloudflarestorage.com
CS_CF_Storage_ForcePathStyle=false
CS_CF_Storage_SecretKey=<CHANGE_ME>

CS_GW_Url=https://cargo.northeurope.cloudapp.azure.com


# --- SMTP (Email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=<CHANGE_ME>
SMTP_USER=<CHANGE_ME>
SMTP_PASSWORD=<CHANGE_ME>                    # Use an App Password, not your Google account password


# --- Redis ---
REDIS_PASSWORD=<CHANGE_ME>
REDIS_CONNECTION_STRING=redis:6379,password=<CHANGE_ME>


# --- Driver Service Configuration ---
DS_ASPNETCORE_ENVIRONMENT=Production
DS_Connection_String="Host=postgres;Port=5432;Database=driver_db;Username=cargo_postgres_prod_user;Password=<CHANGE_ME>"

DS_KC_Authority=https://cargo.northeurope.cloudapp.azure.com/keycloak/realms/cargo-driver
DS_KC_MetadataAddress=http://keycloak:8080/keycloak/realms/cargo-driver/.well-known/openid-configuration
DS_KC_BaseUrl=http://keycloak:8080/keycloak
DS_KC_Realm=cargo-driver
DS_KC_Audience=cargo-backend
DS_KC_Backend_ClientId=cargo-backend
DS_KC_Backend_ClientSecret=<CHANGE_ME>        # Copy from Keycloak Admin → Clients → cargo-backend → Credentials

DS_GW_Url=https://cargo.northeurope.cloudapp.azure.com
